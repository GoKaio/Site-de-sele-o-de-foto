# ── Variáveis de Ambiente ─ COPIE para .env e personalize ──
# NUNCA suba o .env real para o git ou repositórios públicos!

# ── 1. SERVIDOR & AMBIENTE LOCAL ──
PORT=8082
HOST=127.0.0.1
DEBUG=false

# ── 2. SEGURANÇA ──
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_SEGURA_DE_64_CHARS

# ── 3. BANCO DE DADOS (LOCAL vs SUPABASE) ──
# Localmente: usa SQLite (banco.db)
DB_FILE=banco.db

# Na Vercel / Produção: CONECTIVIDADE COM SUPABASE (Seção 3 do Guia)
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection String > Transaction Mode (Porta 6543)
# ATENÇÃO: NUNCA use a porta 5432 na Vercel! Sempre use porta 6543 com Supavisor Pooler.
DATABASE_URL=postgresql://postgres.[SEU-REF-PROJETO]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ── 4. SUPABASE API & STORAGE (CDN GLOBAL) ──
# URL do seu projeto no Supabase
SUPABASE_URL=https://[SEU-PROJETO].supabase.co

# Chave anônima (pode ser exposta ao cliente se necessário, respeita RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ ATENÇÃO CRÍTICA: Chave de Serviço (Service Role Key)
# Acesso TOTAL de administrador ao banco e storage.
# Use EXCLUSIVAMENTE nas variáveis de ambiente da Vercel (Backend).
# JAMAIS prefixe com NEXT_PUBLIC_ ou envie para o navegador!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nome do bucket de fotos no Supabase Storage
SUPABASE_STORAGE_BUCKET=casadafoto-uploads

# ── 5. RATE LIMITING (requests por minuto por IP) ──
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=15

# ── 6. CORS (domínios permitidos - separados por vírgula) ──
ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,https://seu-dominio.vercel.app

# ── 7. ADMIN (credenciais iniciais) ──
ADMIN_LOGIN=GoAdm
ADMIN_SENHA_INICIAL=Go06190608*
