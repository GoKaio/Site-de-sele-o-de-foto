# ── SERVIDOR NODE.JS / EXPRESS ──
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ── BANCO DE DADOS MYSQL ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=casadafoto_db
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# ── CLOUDFLARE R2 (COMPATÍVEL COM AWS S3 SDK v3) ──
# Obtenha em Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_access_key_id_r2
R2_SECRET_ACCESS_KEY=sua_secret_access_key_r2
R2_BUCKET_NAME=casadafoto-uploads
# URL pública configurada para o Bucket R2 (Custom Domain ou *.r2.dev)
R2_PUBLIC_URL=https://pub-subdomain.r2.dev

# ── PROCESSAMENTO SHARP & UPLOAD EM LOTE ──
# Concorrência máxima simultânea durante o redimensionamento e upload
BATCH_CONCURRENCY=4
THUMB_WIDTH=400
THUMB_QUALITY=80
PREVIEW_WIDTH=1920
PREVIEW_QUALITY=85
